{
    "name": "paw-ofelas",
    "version": "0.1.0",
    "private": true,
    "packageManager": "pnpm@11.22.0",
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "biome check .",
        "lint:fix": "biome check --fix .",
        "typecheck": "tsc --noEmit",
        "format": "biome format --write .",
        "format:check": "biome format .",
        "test": "vitest run --project unit",
        "test:watch": "vitest --project unit",
        "e2e": "playwright test && playwright test --config=playwright.a11y.config.ts",
        "e2e:decorator-smoke": "playwright test --config=playwright.decorator-smoke.config.ts",
        "storybook": "storybook dev -p 6006",
        "build-storybook": "storybook build",
        "test-storybook": "vitest --project storybook --run",
        "coverage:components": "vitest --config vitest.components.config.ts --run --coverage",
        "coverage": "vitest --project unit run --coverage",
        "prepare": "husky"
    },
    "dependencies": {
        "@grafana/faro-web-sdk": "2.11.0",
        "@navikt/aksel-icons": "8.16.2",
        "@navikt/arbeidssokerregisteret-utils": "2.1.0",
        "@navikt/ds-css": "8.16.2",
        "@navikt/ds-react": "8.16.2",
        "@navikt/nav-dekoratoren-moduler": "4.3.0",
        "next": "16.3.4",
        "react": "19.2.8",
        "react-dom": "19.2.8"
    },
    "devDependencies": {
        "@axe-core/playwright": "4.13.0",
        "@biomejs/biome": "2.5.12",
        "@playwright/test": "1.63.0",
        "@storybook/addon-a11y": "10.6.0",
        "@storybook/addon-docs": "10.6.0",
        "@storybook/addon-vitest": "10.6.0",
        "@storybook/nextjs-vite": "10.6.0",
        "@tailwindcss/postcss": "4.3.3",
        "@testing-library/jest-dom": "7.0.1",
        "@testing-library/react": "16.3.3",
        "@testing-library/user-event": "14.6.7",
        "@types/node": "26.4.1",
        "@types/react": "19.2.18",
        "@types/react-dom": "19.2.5",
        "@vitest/browser-playwright": "4.1.11",
        "@vitest/coverage-v8": "4.1.11",
        "husky": "9.1.7",
        "playwright": "1.63.0",
        "storybook": "10.6.0",
        "tailwindcss": "4.3.3",
        "typescript": "5.9.3",
        "vite": "8.2.2",
        "vitest": "4.1.11"
    },
    "engines": {
        "node": "24.20.0"
    }
}
