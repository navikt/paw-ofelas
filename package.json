{
    "name": "paw-ofelas",
    "version": "0.1.0",
    "private": true,
    "packageManager": "pnpm@11.28.6",
    "scripts": {
        "biome:migrate": "biome migrate --write",
        "biome:format": "biome format --write ./src",
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "biome check .",
        "lint:fix": "biome check --fix .",
        "typecheck": "tsc --noEmit",
        "format": "biome format --write .",
        "format:check": "biome format .",
        "test": "vitest run --project unit",
        "test:watch": "vitest --project unit",
        "e2e": "playwright test && playwright test --config=playwright.a11y.config.ts",
        "e2e:decorator-smoke": "playwright test --config=playwright.decorator-smoke.config.ts",
        "storybook": "storybook dev -p 6006",
        "build-storybook": "storybook build",
        "test-storybook": "vitest --project storybook --run",
        "coverage:components": "vitest --config vitest.components.config.mts --run --coverage",
        "coverage": "vitest --project unit run --coverage",
        "prepare": "husky"
    },
    "dependencies": {
        "@grafana/faro-web-sdk": "2.12.1",
        "@navikt/aksel-icons": "8.19.1",
        "@navikt/arbeidssokerregisteret-utils": "3.0.1",
        "@navikt/ds-css": "8.19.1",
        "@navikt/ds-react": "8.19.1",
        "@navikt/nav-dekoratoren-moduler": "4.5.1",
        "next": "16.4.2",
        "react": "19.3.0",
        "react-dom": "19.3.0"
    },
    "devDependencies": {
        "@axe-core/playwright": "4.13.0",
        "@biomejs/biome": "2.5.15",
        "@playwright/test": "1.64.0",
        "@storybook/addon-a11y": "10.6.3",
        "@storybook/addon-docs": "10.6.3",
        "@storybook/addon-vitest": "10.6.3",
        "@storybook/nextjs-vite": "10.6.3",
        "@tailwindcss/postcss": "4.3.3",
        "@testing-library/jest-dom": "7.0.1",
        "@testing-library/react": "16.3.3",
        "@testing-library/user-event": "14.6.7",
        "@types/node": "26.6.5",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@vitest/browser-playwright": "5.0.5",
        "@vitest/coverage-v8": "5.0.5",
        "husky": "9.1.7",
        "playwright": "1.64.0",
        "storybook": "10.6.3",
        "tailwindcss": "4.3.3",
        "typescript": "7.0.2",
        "vite": "8.3.4",
        "vitest": "5.0.5"
    },
    "engines": {
        "node": "24.22.1"
    }
}
